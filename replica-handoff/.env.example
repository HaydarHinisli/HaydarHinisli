# Copy to .env and fill in for local/dev use. Never commit a real .env file.

REPLICA_ENV=local
REPLICA_DATABASE_URL=sqlite:///./replica.db
REPLICA_PUBLIC_BASE_URL=http://127.0.0.1:8000
REPLICA_DEMO_MODE=true
REPLICA_AUDIO_ANALYSIS_ENABLED=false
REPLICA_GLOBAL_LEARNING_ENABLED=false

# Auth (Sprint 1). MUST be overridden with a long random secret outside local/demo use.
REPLICA_JWT_SECRET=dev-insecure-change-me-in-production
REPLICA_JWT_EXPIRES_MINUTES=480

# Fix-Sprint after Sprint 3A (ADR-051): Origin allowlist for /ws/live/{call_id},
# on top of its existing JWT auth. Comma-separated. REQUIRED outside REPLICA_ENV=local
# — an unset value there rejects every connection (fail closed), never "allow
# everything". See app/services/ws_origin.py.
REPLICA_ALLOWED_WS_ORIGINS=

# Smart Path / OpenAI Realtime (optional for MVP)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sprint 3A: Twilio "Regions and Edge Locations" for REST API calls REPLICA makes
# TO Twilio (not the inbound webhook/media-stream traffic, which has no region
# concept — see docs/DECISIONS.md ADR-049). Defaults are already EU for the pilot;
# app/integrations/twilio_rest.py refuses to build a client if either is unset
# rather than silently falling back to the Twilio SDK's own us1 default.
TWILIO_REGION=ie1
TWILIO_EDGE=dublin

# Streaming ASR (Sprint 2B). REPLICA_ASR_PROVIDER=simulated (default) needs no
# credentials. Set to 'deepgram' + DEEPGRAM_API_KEY once real-provider verification
# is ready — see docs/DECISIONS.md ADR-045 and docs/PROVIDER_REFERENCES.md.
REPLICA_ASR_PROVIDER=simulated
DEEPGRAM_API_KEY=
DEEPGRAM_REGION=eu
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=de

# CRM / Calendar
HUBSPOT_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=

# Copy to .env and fill in for local/dev use. Never commit a real .env file.

REPLICA_ENV=local
REPLICA_DATABASE_URL=sqlite:///./replica.db
REPLICA_PUBLIC_BASE_URL=http://127.0.0.1:8000
REPLICA_DEMO_MODE=true
REPLICA_AUDIO_ANALYSIS_ENABLED=false
REPLICA_GLOBAL_LEARNING_ENABLED=false

# Smart Path / OpenAI Realtime (optional for MVP)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# CRM / Calendar
HUBSPOT_ACCESS_TOKEN=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_ID=primary
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
